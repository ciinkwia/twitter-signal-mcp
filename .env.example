# twitter-signal-mcp configuration
# This server pays the X Signal API's x402 fee from YOUR OWN wallet.
# In Claude Desktop / Cursor, set these in the MCP server's `env` block rather than a .env file.

# --- Your Coinbase CDP wallet (pays the per-call USDC fee on Base) ---
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# Named CDP account to pay from (created automatically if it doesn't exist).
CDP_ACCOUNT_NAME=twitter-signal-mcp

# --- API endpoint (override only for testing) ---
X_SIGNAL_BASE_URL=https://clink-lithium-vault.fly.dev

# --- Safety guard: never pay more than this many USD for a single call ---
# Digest tier is $0.02, so 0.05 leaves headroom while blocking any runaway charge.
X402_MAX_PRICE=0.05
